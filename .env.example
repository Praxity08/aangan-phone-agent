# --- Database (Neon "Mesa" project, database "aangan") ---
DATABASE_URL=

# --- Security ---
# Password for the dashboard login page (/login). Leave empty to disable auth locally.
DASHBOARD_PASSWORD=
# Shared secret Vaani Labs sends in the x-webhook-secret header (webhook + tool calls).
WEBHOOK_SECRET=

# --- AI classification (Gemini Flash) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# USD per 1M tokens, used to log the cost of every classification.
# Gemini 3.8 Flash paid tier: 0.75 / 3.75 until 31 Dec 2026, then 1.50 / 7.50 from 1 Jan 2027.
GEMINI_INPUT_USD_PER_M=0.75
GEMINI_OUTPUT_USD_PER_M=3.75
USD_TO_INR=88

# --- Voice (Vaani Labs) ---
# Rupees per connected minute. 5.5 is a market benchmark (Inc42, self-serve Indian voice AI),
# NOT a Vaani Labs quote. Replace with the rate on your Vaani contract.
VOICE_INR_PER_MIN=5.5

# --- Designer handoff (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_ESCALATION_CHAT_ID=

# --- CRM (HubSpot private app token, scope crm.objects.deals.write + contacts.write) ---
HUBSPOT_TOKEN=

# --- Booking (Cal.com API v2) ---
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
# Cal.com needs an attendee email; phone callers rarely give one, so bookings use this inbox.
CAL_FALLBACK_EMAIL=
